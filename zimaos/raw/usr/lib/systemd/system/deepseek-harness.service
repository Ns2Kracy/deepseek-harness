[Unit]
Description=DeepSeek Harness
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=HOME=/media/ZimaOS-HD
EnvironmentFile=-/media/ZimaOS-HD/.dsh/.env
WorkingDirectory=/media/ZimaOS-HD
ExecStartPre=/usr/bin/install -d -m 0700 /media/ZimaOS-HD/.dsh
ExecStart=/usr/bin/dsh web --patch /usr/lib/deepseek-harness/zimaos.patch.yml --no-open
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/media /DATA/.dsh
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
